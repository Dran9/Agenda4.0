# Google OAuth (Calendar + Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_ID=danielmacleann@gmail.com

# Google Vision (OCR)
GOOGLE_VISION_API_KEY=
# WhatsApp receipt OCR auto-validation. Leave 0 while Gmail bank emails are the authority.
WHATSAPP_RECEIPT_OCR_ENABLED=0

# Gmail bank QR emails
# Requires GOOGLE_REFRESH_TOKEN with Gmail read-only scope.
GMAIL_QR_EMAIL_ENABLED=0
GMAIL_QR_LABEL=QRterapia
# Polling fallback. With Gmail Pub/Sub enabled, default fallback is 60 min.
GMAIL_QR_POLL_INTERVAL_MINUTES=1
GMAIL_QR_FALLBACK_POLL_INTERVAL_MINUTES=60
BANK_EMAIL_MAX_DELAY_MINUTES=5
BANK_EMAIL_DESTINATION_ACCOUNTS=1006628555
# Optional near-real-time Gmail push via Google Cloud Pub/Sub.
GMAIL_PUBSUB_ENABLED=0
GMAIL_PUBSUB_TOPIC=projects/agenda40/topics/gmail-qr-payments
GMAIL_PUBSUB_PUSH_TOKEN=
GMAIL_WATCH_RENEW_INTERVAL_MINUTES=1440

# WhatsApp Cloud API (Meta)
